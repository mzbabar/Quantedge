<%- include('partials/header') %>
<%
  const freeHref = user ? '/dashboard#free-session' : '/register?next=free';
  const L = 'ABCDE';
  const ch = { q: 'What is the value of 1001² − 999²?', choices: ['2,000', '4,000', '20,000', '40,000', '400,000'], ans: 1 };
%>

<!-- ============ HERO ============ -->
<section class="v-hero">
  <div class="v-hero-bg" aria-hidden="true"></div>
  <div class="wrap v-hero-grid">
    <div class="v-hero-copy">
      <p class="v-pill"><span class="v-dot"></span>GMAT Focus Edition · Live Quant coaching on Zoom</p>
      <h1 class="v-h1">Master GMAT Quant.<br><span class="v-gold">Own every minute.</span></h1>
      <p class="v-lead">21 questions. 45 minutes. No calculator. We teach the shortcuts, pacing and problem-solving habits that turn the Quant section into your strongest score, in small live classes with a real tutor.</p>
      <div class="v-cta-row">
        <a class="btn v-btn-gold" href="/plan">Find your plan · 2-minute quiz</a>
        <a class="btn v-btn-ghost" href="<%= freeHref %>">Book a free 1-on-1 session</a>
      </div>
      <% if (proof.rating) { %>
      <div class="v-proof-badge">
        <% if (proof.faces.length) { %><span class="v-faces"><% proof.faces.forEach(t => { %><img src="<%= t.photo %>" alt="<%= t.name %>" width="36" height="36" loading="lazy"><% }) %></span><% } %>
        <span><span class="v-stars" aria-hidden="true">★★★★★</span><b>Rated <%= proof.rating %>/5</b><% if (proof.ratingCount) { %> by <%= proof.ratingCount %> students<% } %></span>
      </div>
      <% } else { %>
      <ul class="v-trust">
        <li><%- include('partials/icon', { name: 'check' }) %>30 minutes, no payment details</li>
        <li><%- include('partials/icon', { name: 'check' }) %>Set up your bootcamp during the free class</li>
      </ul>
      <% } %>
    </div>

    <!-- 60-second challenge: works without JavaScript (the solution is a <details>), and becomes interactive with it -->
    <div class="v-challenge reveal" id="challenge" data-answer="<%= ch.ans %>">
      <div class="v-ch-head">
        <span class="v-ch-tag">60-second challenge</span>
        <span class="v-ch-timer" aria-hidden="true"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" class="ring-bg"/><circle cx="18" cy="18" r="15.5" class="ring" id="ch-ring"/></svg><b id="ch-secs">60</b></span>
      </div>
      <p class="v-ch-q"><%= ch.q %></p>
      <div class="v-ch-choices" role="group" aria-label="Answer choices">
        <% ch.choices.forEach((c, k) => { %><button type="button" class="v-ch-choice" data-k="<%= k %>"><span><%= L[k] %></span><%= c %></button><% }) %>
      </div>
      <p class="v-ch-result" id="ch-result" hidden></p>
      <details class="v-ch-sol" id="ch-sol">
        <summary>Show the 5-second trick</summary>
        <p><b>Answer: (B) 4,000.</b> Don't square four-digit numbers. Use the difference of squares: a² − b² = (a + b)(a − b) = 2000 × 2 = 4,000.</p>
      </details>
      <a class="v-ch-more" href="/quiz">Try 12 more and get your score range →</a>
    </div>
  </div>

  <div class="wrap">
    <div class="v-stats reveal">
      <div><span class="v-stat" data-count="21">21</span><span>Quant questions</span></div>
      <div><span class="v-stat" data-count="45">45</span><span>minutes, no calculator</span></div>
      <div><span class="v-stat">2:08</span><span>per question on average</span></div>
      <div><span class="v-stat">60–90</span><span>Quant section score</span></div>
    </div>
  </div>
</section>


<% if (proof.hasAny) { %>
<!-- ============ RESULTS (shown only when real social proof is added in /admin) ============ -->
<section class="v-section v-results" id="results">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">Real students. Real results.</p>
      <h2 class="v-h2">What our students say.</h2>
    </div>
    <% if (proof.video) { %>
    <div class="v-video reveal">
      <div class="v-video-frame"><iframe src="https://www.youtube-nocookie.com/embed/<%= proof.video %>?rel=0" title="<%= proof.videoTitle %>" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
      <p class="v-video-cap"><%= proof.videoTitle %></p>
    </div>
    <% } %>
    <% if (proof.testimonials.length) { %>
    <div class="v-quotes">
      <% proof.testimonials.slice(0, 6).forEach(t => { %>
      <figure class="v-quote reveal">
        <% if (t.before && t.after) { %><div class="v-gain"><span><%= t.before %></span><%- include('partials/icon', { name: 'arrow' }) %><b><%= t.after %></b></div><% } %>
        <blockquote>“<%= t.quote %>”</blockquote>
        <figcaption><% if (t.photo) { %><img src="<%= t.photo %>" alt="" width="44" height="44" loading="lazy"><% } %><span><b><%= t.name %></b><% if (t.detail) { %><br><%= t.detail %><% } %></span></figcaption>
      </figure>
      <% }) %>
    </div>
    <% } %>
    <% if (proof.stats.length) { %>
    <div class="v-results-stats reveal">
      <% proof.stats.forEach(st => { %><div><span><%= st.value %></span><%= st.label %></div><% }) %>
    </div>
    <% } %>
    <% if (proof.schools.length) { %>
    <div class="v-schools reveal">
      <p>Our students are headed to</p>
      <ul><% proof.schools.forEach(sc => { %><li><%= sc %></li><% }) %></ul>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- ============ FEATURES ============ -->
<section class="v-section v-ivory" id="features">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">Everything included</p>
      <h2 class="v-h2">Everything you need to master GMAT Quant, in one place.</h2>
    </div>
    <div class="v-features">
      <% [
        ['video', 'Live classes with a real tutor', 'Eight live Zoom classes. Ask questions in the moment instead of rewinding a video.'],
        ['users', 'Small groups', 'Small classes, so the tutor knows your weak spots and every question gets answered.'],
        ['target', 'A plan built around you', 'Your test date, target score and starting level shape what you practice and when.'],
        ['clock', 'Pacing training', 'Per-question time targets and the 2-minute "move on" rule, practiced in every class.'],
        ['file', 'Timed practice sets', 'Weekly sets in real GMAT Focus style, each with step-by-step worked solutions.'],
        ['chart', 'Full-length practice test', 'A 21-question, 45-minute Quant section with a score range, topic breakdown and pacing chart.'],
        ['chat', 'Ask-the-tutor support', 'Stuck between classes? Send the question from your dashboard and get a written reply.'],
        ['play', 'Class recordings', 'Missed a class or want a second look? Every recording is in your student area.'],
        ['calendar', 'Flexible scheduling', 'Set up your bootcamp sessions during your free class, at times that fit your week.'],
      ].forEach(([ic, h, p]) => { %>
      <article class="v-feature reveal"><div class="v-ico v-ico-sm"><%- include('partials/icon', { name: ic }) %></div><h3><%= h %></h3><p><%= p %></p></article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ WHAT'S TESTED ============ -->
<section class="v-section" id="gmat-quant">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">The Quant section, decoded</p>
      <h2 class="v-h2">Four topic areas. One skill that ties them together: <span class="v-under">speed with accuracy.</span></h2>
      <p class="v-sub">The GMAT Focus Edition has three 45-minute sections taken in any order. Quant is 21 problem-solving questions, computer-adaptive, and you can review and change up to 3 answers.</p>
    </div>
    <div class="v-topics">
      <article class="v-topic reveal"><div class="v-ico"><%- include('partials/icon', { name: 'hash' }) %></div><h3>Arithmetic &amp; number properties</h3><p>Divisibility, primes, remainders, units digits, fractions, percents and ratios.</p></article>
      <article class="v-topic reveal"><div class="v-ico"><%- include('partials/icon', { name: 'x' }) %></div><h3>Algebra</h3><p>Equations, inequalities, absolute value, exponents, functions and coordinate geometry.</p></article>
      <article class="v-topic reveal"><div class="v-ico"><%- include('partials/icon', { name: 'route' }) %></div><h3>Word problems</h3><p>Rates and work, mixtures, profit and interest, ages, overlapping sets.</p></article>
      <article class="v-topic reveal"><div class="v-ico"><%- include('partials/icon', { name: 'chart' }) %></div><h3>Statistics &amp; counting</h3><p>Mean, median, standard deviation, combinations and probability.</p></article>
    </div>
    <p class="v-note reveal"><%- include('partials/icon', { name: 'info' }) %>Plane geometry is no longer tested, and Data Sufficiency moved to Data Insights. Many older prep books still teach both.</p>
  </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="v-section">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">How it works</p>
      <h2 class="v-h2">From first question to test day, in three steps.</h2>
    </div>
    <ol class="v-steps">
      <li class="reveal"><span class="v-step-n">01</span><h3>Take the 2-minute plan quiz</h3><p>Five quick questions about your test date, target score and level. You get a personalized plan right away. Want a score too? Take the free practice test.</p><a class="v-step-link" href="/plan">Find your plan →</a></li>
      <li class="reveal"><span class="v-step-n">02</span><h3>Book a free 1-on-1 Zoom call</h3><p>We work timed questions together, diagnose where you lose points, and confirm your plan. You also get the option to set up your bootcamp sessions.</p><a class="v-step-link" href="<%= freeHref %>">Book the call →</a></li>
      <li class="reveal"><span class="v-step-n">03</span><h3>Train in the bootcamp</h3><p>Four weeks of live classes, timed practice sets and direct tutor support, finishing with a full Quant section review before test day.</p></li>
    </ol>
  </div>
</section>

<!-- ============ PRACTICE TEST SHOWCASE ============ -->
<section class="v-section v-dark" id="practice">
  <div class="wrap v-split">
    <div class="reveal">
      <p class="eyebrow v-eyebrow-gold">Free · Full-length</p>
      <h2 class="v-h2">Feel test day before test day.</h2>
      <p class="v-sub v-sub-dark">A complete Quant section under real GMAT rules: one question at a time, a 45-minute clock that never stops, bookmarks, and an end-of-section review where you can change up to 3 answers.</p>
      <ul class="v-checks">
        <li><%- include('partials/icon', { name: 'check' }) %>Practice score range on the 60–90 scale</li>
        <li><%- include('partials/icon', { name: 'check' }) %>Accuracy by topic and a pacing chart for all 21 questions</li>
        <li><%- include('partials/icon', { name: 'check' }) %>Step-by-step solutions for every question</li>
      </ul>
      <div class="v-cta-row"><a class="btn v-btn-gold" href="/practice-test">Start the practice test</a><a class="v-link-light" href="/quiz">Or the 12-question score check →</a></div>
    </div>
    <div class="v-mock reveal" aria-hidden="true">
      <div class="v-mock-bar"><span class="v-mock-brand"><%- include('partials/mark', { m: '#ffffff' }) %>Quantitative Reasoning</span><span>Question 14 of 21</span><span class="v-mock-time">23:41</span></div>
      <div class="v-mock-body">
        <p class="v-mock-q">The ratio of boys to girls in a class is 3 : 5. After 6 more boys join, the ratio becomes 3 : 4. How many students were in the class originally?</p>
        <div class="v-mock-ch"><span>A</span>40</div>
        <div class="v-mock-ch"><span>B</span>48</div>
        <div class="v-mock-ch"><span>C</span>56</div>
        <div class="v-mock-ch on"><span>D</span>64</div>
        <div class="v-mock-ch"><span>E</span>72</div>
      </div>
      <div class="v-mock-foot"><span class="v-mock-bm">Bookmark</span><span class="v-mock-next">Next</span></div>
    </div>
  </div>
</section>

<!-- ============ SAMPLE QUESTIONS ============ -->
<section id="samples" class="v-section">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">Try it now</p>
      <h2 class="v-h2">Two questions. See how we teach.</h2>
      <p class="v-sub">Original GMAT-style questions from our bootcamp practice sets. Give yourself about 2 minutes each, no calculator, then open the step-by-step solution.</p>
    </div>
    <div class="sample-grid">
    <% samples.forEach(s => { %>
      <article class="card sample reveal">
        <div class="sample-meta"><span class="tag tag-class">Sample <%= s.n %></span><span class="small muted"><%= s.topic %> · target <%= s.time %></span></div>
        <p class="sample-q"><%= s.q %></p>
        <ol class="choices">
          <% s.choices.forEach((c, i) => { %><li><span class="letter"><%= L[i] %></span><%= c %></li><% }) %>
        </ol>
        <details class="solution">
          <summary>Show answer &amp; step-by-step solution</summary>
          <p class="answer">Answer: (<%= L[s.ans] %>) <%= s.choices[s.ans] %></p>
          <div class="concept"><strong>Concept: <%= s.concept %></strong><br><%= s.idea %></div>
          <ol class="sol-steps"><% s.steps.forEach(st => { %><li><%= st %></li><% }) %></ol>
          <p class="tip"><strong><%= s.tipLabel %>:</strong> <%= s.tip %></p>
        </details>
      </article>
    <% }) %>
    </div>
  </div>
</section>

<!-- ============ COMPARISON ============ -->
<section class="v-section v-ivory" id="compare">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">Why MZB Academy</p>
      <h2 class="v-h2">A better way to prep for GMAT Quant.</h2>
      <p class="v-sub">Live teaching where it matters most, without the price of private tutoring.</p>
    </div>
    <% const Y = '<span class="cmp-y" aria-label="Yes">✓</span>', N = '<span class="cmp-n" aria-label="No">✕</span>';
       const rows = [
         ['Live classes with a real tutor', Y, 'Often an extra cost', N],
         ['Built for the GMAT Focus Quant section', Y, 'Usually', 'Varies'],
         ['Small groups, questions answered live', Y, 'Varies', N],
         ['Free 1-on-1 planning session', Y, 'Varies', N],
         ['Full-length timed Quant test with pacing analysis', Y, 'Usually', 'Varies'],
         ['Ask-the-tutor support between classes', Y, 'Varies', N],
         ['Cost of live teaching', '<b>' + site.bootcampPrice + '</b> for 8 live classes', 'Private tutoring often $165–$200+ an hour', 'Low, but no live teaching'],
       ]; %>
    <div class="cmp-wrap reveal">
      <table class="cmp">
        <thead><tr><th></th><th class="cmp-us"><%- include('partials/mark') %><span>MZB Academy</span></th><th>Big-brand courses</th><th>Self-study books &amp; apps</th></tr></thead>
        <tbody>
          <% rows.forEach(r => { %><tr><th scope="row"><%= r[0] %></th><td class="cmp-us"><%- r[1] %></td><td><%- r[2] %></td><td><%- r[3] %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
    <p class="small muted cmp-note">Big-brand comparisons are general and vary by provider and package. Tutoring rates from published 2026 GMAT prep price reviews.</p>
  </div>
</section>

<!-- ============ BOOTCAMP ============ -->
<section id="bootcamp" class="v-section">
  <div class="wrap">
    <div class="v-head reveal">
      <p class="eyebrow">4-week live bootcamp</p>
      <h2 class="v-h2">A focused plan that covers every Quant topic, in four weeks.</h2>
    </div>
    <div class="v-boot">
      <div class="v-weeks">
        <div class="v-week reveal"><span class="v-week-n">Week 1</span><h3>Number properties &amp; arithmetic</h3><p>Divisibility, remainders, fractions, percents and the mental-math shortcuts that replace a calculator.</p></div>
        <div class="v-week reveal"><span class="v-week-n">Week 2</span><h3>Algebra</h3><p>Equations, inequalities, absolute value, functions, exponents and roots.</p></div>
        <div class="v-week reveal"><span class="v-week-n">Week 3</span><h3>Word problems</h3><p>Rates, work, mixtures, percents, ratios and interest, and how to set them up fast.</p></div>
        <div class="v-week reveal"><span class="v-week-n">Week 4</span><h3>Statistics, counting &amp; pacing</h3><p>Probability and combinatorics, then full timed sections and your personal pacing plan.</p></div>
      </div>
      <aside class="v-price reveal">
        <p class="v-price-tag">GMAT Quant Bootcamp</p>
        <div class="v-price-num"><%= site.bootcampPrice %></div>
        <p class="v-price-sub">one-time · 4 weeks · live on Zoom</p>
        <ul class="v-checks v-checks-dark">
          <li><%- include('partials/icon', { name: 'check' }) %>8 live Zoom classes (2 per week)</li>
          <li><%- include('partials/icon', { name: 'check' }) %>Weekly timed practice sets with worked solutions</li>
          <li><%- include('partials/icon', { name: 'check' }) %>Class recordings in your student area</li>
          <li><%- include('partials/icon', { name: 'check' }) %>Ask-the-tutor support between classes</li>
          <li><%- include('partials/icon', { name: 'check' }) %>Full-length Quant review before test day</li>
        </ul>
        <a class="btn v-btn-gold btn-block" href="<%= user ? '/dashboard#bootcamp' : '/register' %>">Register for the bootcamp</a>
        <p class="v-price-note">Not sure yet? <a href="<%= freeHref %>">Start with the free session</a>. During your free class, you'll get the option to set up your bootcamp sessions.</p>
      </aside>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section id="faq" class="v-section">
  <div class="wrap v-faq">
    <div class="v-faq-side reveal">
      <p class="eyebrow">Questions</p>
      <h2 class="v-h2">GMAT Quant FAQ</h2>
      <p class="v-sub">Still deciding? A free 30-minute session is the fastest way to get a straight answer about your situation.</p>
      <a class="btn v-btn-navy" href="<%= freeHref %>">Book a free session</a>
    </div>
    <div class="v-faq-list reveal">
      <% faq.forEach(([q, ans]) => { %><details><summary><%= q %></summary><p><%= ans %></p></details>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section class="v-final">
  <div class="wrap v-final-inner reveal">
    <h2>Ready to get started? Your Quant score is the most trainable part of the GMAT.</h2>
    <p>Start with a free 30-minute session. Leave with a plan.</p>
    <div class="v-cta-row v-center"><a class="btn v-btn-navy" href="/plan">Find your plan · 2-minute quiz</a><a class="btn v-btn-outline-navy" href="<%= freeHref %>">Book my free session</a></div>
  </div>
</section>

<script src="/site.js" defer></script>
<%- include('partials/footer') %>
