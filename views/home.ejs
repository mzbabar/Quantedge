<section id="gmat-quant" class="section">
  <div class="wrap">
    <h2>What's on the GMAT Quant section</h2>
    <p class="section-lead">The current GMAT (Focus Edition) has three 45-minute sections — Quantitative Reasoning, Verbal Reasoning and Data Insights — 64 questions in total, taken in any order you choose.</p>
    <div class="grid-3">
      <div class="card">
        <h3>Format</h3>
        <ul class="ticks">
          <li>21 Problem Solving questions (multiple choice)</li>
          <li>45 minutes — about 2 minutes 8 seconds each</li>
          <li>Computer-adaptive: difficulty adjusts to your answers</li>
          <li>No calculator allowed</li>
          <li>You can review and change up to 3 answers per section</li>
        </ul>
      </div>
      <div class="card">
        <h3>Content tested</h3>
        <ul class="ticks">
          <li><strong>Arithmetic:</strong> number properties, fractions, percents, ratios</li>
          <li><strong>Algebra:</strong> equations, inequalities, functions, exponents</li>
          <li><strong>Word problems:</strong> rates, work, mixtures, interest</li>
          <li><strong>Statistics &amp; counting:</strong> averages, sets, probability, combinatorics</li>
          <li>Plane geometry was removed; Data Sufficiency moved to Data Insights</li>
        </ul>
      </div>
      <div class="card">
        <h3>Scoring</h3>
        <ul class="ticks">
          <li>Quant section score: 60–90</li>
          <li>Total GMAT score: 205–805</li>
          <li>All three sections weigh equally in your total</li>
          <li>Unanswered questions cost you — pacing is a real skill</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <h2>How it works</h2>
    <div class="steps">
      <div class="step"><span>1</span><h3>Create a free account</h3><p>Takes one minute. Tell us your test date and target score.</p></div>
      <div class="step"><span>2</span><h3>Free 1-on-1 Zoom session</h3><p>We work a few timed questions together, spot your weak areas, and build a study plan.</p></div>
      <div class="step"><span>3</span><h3>Join the bootcamp</h3><p>Four weeks of live classes, practice sets and direct support until test day.</p></div>
    </div>
  </div>
</section>

<section id="samples" class="section samples">
  <div class="wrap">
    <p class="eyebrow">Free practice</p>
    <h2>Try two sample questions</h2>
    <p class="section-lead">Original GMAT-style questions from our bootcamp practice sets. Give yourself about 2 minutes each, with no calculator, then open the step-by-step solution.</p>
<%
  const samples = [
    { n: 1, topic: 'Word problems · rates', time: '2:00',
      q: 'Towns A and B are 270 miles apart. Priya leaves A at 9:00 a.m., driving toward B at 50 mph. At 10:00 a.m., Omar leaves B, driving toward A at 60 mph. How far from Town A are they when they meet?',
      choices: ['120 miles', '135 miles', '150 miles', '160 miles', '170 miles'], ans: 2,
      concept: 'Relative speed (closing speed)',
      idea: 'Two objects moving toward each other close the gap at the sum of their speeds: time to meet = gap ÷ (speed₁ + speed₂).',
      steps: ['Head start first: by 10:00 Priya has driven 50 × 1 = 50 miles.', 'Gap left when both are moving: 270 − 50 = 220 miles.', 'They close the gap at 50 + 60 = 110 mph, so they meet 220 ÷ 110 = 2 hours later.', 'Priya\'s distance from A: 50 + (50 × 2) = 150 miles.'],
      tipLabel: 'Quick check', tip: 'Omar drives 60 × 2 = 120 miles, and 150 + 120 = 270 ✓. Forgetting the head start gives messy numbers, which is a sign the setup is wrong.' },
    { n: 2, topic: 'Arithmetic · percents', time: '1:30',
      q: 'The price of a jacket is increased by 20%, then decreased by 25%, and then increased by 10%. What is the overall change from the original price?',
      choices: ['5% increase', '1% increase', 'No change', '1% decrease', '5% decrease'], ans: 3,
      concept: 'Successive percent changes',
      idea: 'Percent changes multiply; they don\'t add. Turn each change into a multiplier: +20% → ×1.20, −25% → ×0.75, +10% → ×1.10.',
      steps: ['Pick a smart number: let the original price be $100.', 'After +20%: 100 × 1.2 = 120.', 'After −25%: 120 × 0.75 = 90.', 'After +10%: 90 × 1.1 = 99, so the price is 1% lower than at the start.'],
      tipLabel: 'Trap to avoid', tip: 'Adding 20 − 25 + 10 = +5% is the classic trap answer. Multipliers, always.' },
  ];
  const L = 'ABCDE';
%>
    <div class="sample-grid">
    <% samples.forEach(s => { %>
      <article class="card sample">
        <div class="sample-meta"><span class="tag tag-class">Sample <%= s.n %></span><span class="small muted"><%= s.topic %> · target <%= s.time %></span></div>
        <p class="sample-q"><%= s.q %></p>
        <ol class="choices">
          <% s.choices.forEach((c, i) => { %><li><span class="letter"><%= L[i] %></span><%= c %></li><% }) %>
        </ol>
        <details class="solution">
          <summary>Show answer &amp; step-by-step solution</summary>
          <p class="answer">Answer: (<%= L[s.ans] %>) <%= s.choices[s.ans] %></p>
          <div class="concept"><strong>Concept: <%= s.concept %></strong><br><%= s.idea %></div>
          <ol class="sol-steps"><% s.steps.forEach(st => { %><li><%= st %></li><% }) %></ol>
          <p class="tip"><strong><%= s.tipLabel %>:</strong> <%= s.tip %></p>
        </details>
      </article>
    <% }) %>
    </div>
    <p class="center sample-cta">Want 24 more like these, with live walkthroughs? <a href="<%= user ? '/dashboard#free-session' : '/register?next=free' %>">Book your free Zoom session →</a></p>
  </div>
</section>

