<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= site.name %></title>
  <meta name="description" content="Live GMAT Quantitative Reasoning coaching on Zoom. Free intro session and a 4-week bootcamp.">
  <style><%- inlineCss %></style>
</head>
<body>
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/"><span class="logo">Σ</span><%= site.name %></a>
    <nav>
      <% if (path === '/') { %>
        <a href="#gmat-quant">The Quant section</a>
        <a href="#samples">Sample questions</a>
        <a href="#bootcamp">Bootcamp</a>
        <a href="#faq">FAQ</a>
      <% } %>
      <% if (user) { %>
        <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <a href="/dashboard">Dashboard</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="link">Log out</button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="btn btn-sm" href="/register?next=free">Book free session</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
<% if (flash) { %>
  <div class="wrap"><div class="flash flash-<%= flash.type %>"><%= flash.msg %></div></div>
<% } %>
