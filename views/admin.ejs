<%- include('partials/header') %>
<% const fmt = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); %>
<section class="section">
  <div class="wrap">
    <p class="eyebrow">Tutor admin</p>
    <h1>Dashboard</h1>
    <div class="card" id="visits">
      <div class="visits-head">
        <h2>Site traffic</h2>
        <span class="small muted">Private: only you can see this<% if (visits.since) { %> · counting since <%= visits.since %><% } %> · your own visits and bots aren't counted</span>
      </div>
      <% const n = (x) => (x || 0).toLocaleString(); const fmtDay = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }); %>
      <div class="traffic-table">
        <div class="tt-row tt-head"><span></span><span>Today</span><span>This week</span><span>This month</span><span>All time</span></div>
        <div class="tt-row"><span class="tt-label"><i class="sw sw-views"></i>Page views</span><b data-l="Today"><%= n(visits.views.today) %></b><b data-l="This week"><%= n(visits.views.week) %></b><b data-l="This month"><%= n(visits.views.month) %></b><b data-l="All time"><%= n(visits.views.total) %></b></div>
        <div class="tt-row"><span class="tt-label"><i class="sw sw-uniq"></i>Unique visitors</span><b data-l="Today"><%= n(visits.uniques.today) %></b><b data-l="This week"><%= n(visits.uniques.week) %></b><b data-l="This month"><%= n(visits.uniques.month) %></b><b data-l="All time"><%= n(visits.uniques.total) %></b></div>
      </div>
      <p class="small muted" style="margin:4px 0 0">Week starts Monday (<%= fmtDay(visits.weekStart) %>). Visits (a person arriving, or returning after 30+ minutes): <%= n(visits.sessions.today) %> today, <%= n(visits.sessions.month) %> in the last 30 days, <%= n(visits.sessions.total) %> all time.</p>

      <% const maxV = Math.max(1, ...visits.last30.map(d => d.views || 0)); %>
      <p class="small muted" style="margin:18px 0 4px">Last 30 days: <i class="sw sw-views"></i>page views and <i class="sw sw-uniq"></i>unique visitors per day</p>
      <div class="visit-chart">
        <% visits.last30.forEach((d, i) => { const v = d.views || 0, u = d.uniques || 0; %>
        <div class="visit-col" title="<%= fmtDay(d.day) %>: <%= v %> page views, <%= u %> unique visitors">
          <span class="visit-n"><%= v || '' %></span>
          <span class="visit-stack" style="height: <%= v ? Math.max(4, Math.round(100 * v / maxV)) : 0 %>%">
            <span class="visit-uniq" style="height: <%= v ? Math.round(100 * Math.min(u, v) / v) : 0 %>%"></span>
          </span>
          <span class="visit-day"><%= (i % 5 === 4 || i === 29) ? fmtDay(d.day) : '' %></span>
        </div>
        <% }) %>
      </div>

      <details class="visit-pages">
        <summary>Day-by-day numbers (last 30 days)</summary>
        <table>
          <tr><th>Date</th><th style="text-align:right">Unique visitors</th><th style="text-align:right">Visits</th><th style="text-align:right">Page views</th></tr>
          <% visits.last30.slice().reverse().filter(d => !visits.since || d.day >= visits.since || d.views).forEach(d => { %><tr><td><%= fmtDay(d.day) %></td><td style="text-align:right"><%= d.uniques === undefined ? (d.views ? '—' : 0) : n(d.uniques) %></td><td style="text-align:right"><%= n(d.visits) %></td><td style="text-align:right"><%= n(d.views) %></td></tr><% }) %>
        </table>
      </details>
      <% if (visits.pages.length) { %>
      <details class="visit-pages">
        <summary>Most viewed pages (all time)</summary>
        <table>
          <tr><th>Page</th><th style="text-align:right">Views</th></tr>
          <% visits.pages.forEach(([pg, c]) => { %><tr><td><%= pg === '/' ? 'Home page' : pg %></td><td style="text-align:right"><%= n(c) %></td></tr><% }) %>
        </table>
      </details>
      <% } %>
    </div>

    <div class="kpis">
      <div class="kpi"><span class="num"><%= leads.filter(l => l.type !== 'guide').length %></span>score-plan leads</div>
      <div class="kpi"><span class="num"><%= leads.filter(l => l.type === 'guide').length %></span>Playbook downloads</div>
      <div class="kpi"><span class="num"><%= testAttempts.length %></span>practice tests taken</div>
      <div class="kpi"><span class="num"><%= quizAttempts.length %></span>score checks taken</div>
      <div class="kpi"><span class="num"><%= students.length %></span>students</div>
      <div class="kpi"><span class="num"><%= sessions.filter(s => s.status === 'requested').length %></span>free sessions to schedule</div>
      <div class="kpi"><span class="num"><%= enrollments.filter(e => e.status === 'pending_payment').length %></span>bootcamp pending payment</div>
      <div class="kpi"><span class="num"><%= enrollments.filter(e => e.status === 'active').length %></span>bootcamp enrolled</div>
      <div class="kpi"><span class="num"><%= questions.filter(q => !q.reply).length %></span>unanswered questions</div>
    </div>

    <div class="card" id="sessions">
      <h2>Free session requests</h2>
      <% if (!sessions.length) { %><p class="muted">None yet.</p><% } %>
      <% sessions.forEach(s => { %>
        <form method="post" action="/admin/session/<%= s.id %>" class="admin-row">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="who"><strong><%= s.student.name %></strong><br><span class="small muted"><%= s.student.email %> · asked <%= fmt(s.createdAt) %></span>
            <div class="small">Prefers: <%= s.preferred1.replace('T',' ') %><%= s.preferred2 ? ' / ' + s.preferred2.replace('T',' ') : '' %> (<%= s.timezone %>)</div>
            <% if (s.notes) { %><div class="small muted prewrap">“<%= s.notes %>”</div><% } %>
          </div>
          <input name="scheduledFor" placeholder="Confirmed time, e.g. Oct 3, 7pm ET" value="<%= s.scheduledFor %>">
          <input name="zoomLink" type="url" placeholder="https://zoom.us/j/..." value="<%= s.zoomLink %>">
          <select name="status"><% ['requested','scheduled','completed','cancelled'].forEach(o => { %><option <%= s.status === o ? 'selected' : '' %>><%= o %></option><% }) %></select>
          <button class="btn btn-sm">Save</button>
        </form>
      <% }) %>
    </div>

    <div class="card" id="enrollments">
      <h2>Bootcamp registrations</h2>
      <% if (!enrollments.length) { %><p class="muted">None yet.</p><% } %>
      <% enrollments.forEach(e => { %>
        <div class="row-with-del">
        <form method="post" action="/admin/enrollment/<%= e.id %>" class="admin-row">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="who"><strong><%= e.student.name %></strong><br><span class="small muted"><%= e.student.email %> · <%= e.cohort %> · <%= fmt(e.createdAt) %></span></div>
          <select name="status"><% ['pending_payment','active','cancelled'].forEach(o => { %><option <%= e.status === o ? 'selected' : '' %>><%= o %></option><% }) %></select>
          <button class="btn btn-sm">Save</button>
        </form>
        <details class="del"><summary>Delete</summary><form method="post" action="/admin/enrollment/<%= e.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Yes, delete</button></form></details>
        </div>
      <% }) %>
      <% if (enrollments.length) { %>
      <details class="del del-all"><summary>Clear all bootcamp registrations…</summary>
        <form method="post" action="/admin/enrollments/clear" class="clear-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="consent"><input type="checkbox" name="confirm" value="yes" required> I understand this permanently deletes all <%= enrollments.length %> bootcamp registrations. This can't be undone.</label>
          <button class="btn btn-sm btn-danger">Delete all</button></form></details>
      <% } %>
    </div>

    <div class="card" id="posts">
      <h2>Share with students</h2>
      <form method="post" action="/admin/post" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row2">
          <label>Type<select name="kind"><option value="announcement">Announcement</option><option value="class">Class / Zoom link</option><option value="resource">Resource / practice set</option></select></label>
          <label>Who sees it<select name="audience"><option value="all">All students</option><option value="bootcamp">Enrolled bootcamp students only</option></select></label>
        </div>
        <label>Title<input name="title" required maxlength="150"></label>
        <label>Details<textarea name="body" rows="3"></textarea></label>
        <label>Link <span class="muted">(Zoom, Google Drive, PDF…)</span><input name="link" type="url"></label>
        <button class="btn">Post</button>
      </form>
      <% posts.forEach(p => { %>
        <div class="admin-row">
          <div class="who"><strong><%= p.title %></strong><br><span class="small muted"><%= p.kind %> · <%= p.audience %> · <%= fmt(p.createdAt) %></span></div>
          <form method="post" action="/admin/post/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost">Delete</button></form>
        </div>
      <% }) %>
    </div>

    <div class="card" id="questions">
      <h2>Student questions</h2>
      <% if (!questions.length) { %><p class="muted">None yet.</p><% } %>
      <% questions.forEach(q => { %>
        <form method="post" action="/admin/question/<%= q.id %>/reply" class="qa">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="small muted"><strong><%= q.student.name %></strong> · <%= q.topic %> · <%= fmt(q.createdAt) %></div>
          <p class="prewrap"><%= q.body %></p>
          <textarea name="reply" rows="2" placeholder="Your reply"><%= q.reply %></textarea>
          <button class="btn btn-sm">Save reply</button>
        </form>
      <% }) %>
    </div>

    <div class="card" id="leads">
      <h2>Leads: score plans &amp; Playbook downloads</h2>
      <p class="small muted">People who took the 2-minute score plan or downloaded the free Playbook. Follow up about the free call. Emails are for following up about the free session; only email marketing tips to people marked ✓ for consent.</p>
      <% if (!leads.length) { %><p class="muted">None yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <tr><th>Date</th><th>Source</th><th>Name</th><th>Email</th><th>Goal</th><th>Quant now</th><th>Test date</th><th>Challenge</th><th>Tips ok</th><th>Status</th><th></th></tr>
        <% leads.slice().sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt))).forEach(l => { const a = l.answers || {}; const isGuide = l.type === 'guide'; %>
        <tr>
          <td><%= fmt(l.createdAt) %></td><td><span class="tag"><%= isGuide ? 'Playbook' : 'Score plan' %></span></td>
          <td><% if (isGuide) { %><%= l.name %><% } else { %><a href="/plan/<%= l.id %>"><%= l.name %></a><% } %></td><td><%= l.email %></td>
          <td><%= planLabel('target', a.target) || '—' %></td><td><%= planLabel('level', a.level) || '—' %></td><td><%= planLabel('date', a.date) || '—' %></td><td><%= planLabel('struggle', a.struggle) || '—' %></td>
          <td><%= l.consent ? '✓' : '—' %></td>
          <td><form method="post" action="/admin/lead/<%= l.id %>" class="inline lead-status"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <select name="status"><% ['new', 'contacted', 'booked', 'enrolled', 'not a fit'].forEach(o => { %><option <%= (l.status || 'new') === o ? 'selected' : '' %>><%= o %></option><% }) %></select>
            <button class="btn btn-sm">Save</button></form></td>
          <td><details class="del"><summary>Delete</summary><form method="post" action="/admin/lead/<%= l.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Yes, delete</button></form></details></td>
        </tr>
        <% }) %>
      </table></div>
      <% } %>
      <% if (leads.length) { %>
      <details class="del del-all"><summary>Clear all leads…</summary>
        <form method="post" action="/admin/leads/clear" class="clear-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="consent"><input type="checkbox" name="confirm" value="yes" required> I understand this permanently deletes all <%= leads.length %> leads. This can't be undone.</label>
          <button class="btn btn-sm btn-danger">Delete all</button></form></details>
      <% } %>
    </div>

    <div class="card" id="tutor">
      <h2>Tutor profile (front and center on the home page)</h2>
      <p class="small muted">Shown in the home page hero and a "Meet your tutor" section as soon as a name is saved. Leave the name empty to hide it.</p>
      <form method="post" action="/admin/tutor" class="form proof-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row2">
          <label>Name<input name="tutorName" maxlength="80" value="<%= proof.tutorName %>" placeholder="e.g. M. Z. Babar"></label>
          <label>Title<input name="tutorTitle" maxlength="120" value="<%= proof.tutorTitle %>" placeholder="e.g. Founder &amp; lead GMAT Quant tutor"></label>
        </div>
        <div class="row2">
          <label>Photo URL<input name="tutorPhoto" value="<%= proof.tutorPhoto %>" placeholder="https://… (square photo works best)"></label>
          <label>Score / headline result<input name="tutorScore" maxlength="60" value="<%= proof.tutorScore %>" placeholder="e.g. GMAT Quant 90 (100th percentile)"></label>
        </div>
        <label>Short quote for the hero card (1–2 sentences)<textarea name="tutorBio" rows="2" maxlength="400" placeholder="Why you teach, in your own words"><%= proof.tutorBio %></textarea></label>
        <label>Your story (blank line between paragraphs)<textarea name="tutorStory" rows="6" maxlength="3000"><%= proof.tutorStory %></textarea></label>
        <label>Credentials (one per line, up to 6)<textarea name="tutorCreds" rows="4" maxlength="800" placeholder="10+ years teaching math&#10;MBA, …"><%= proof.tutorCreds %></textarea></label>
        <label>Intro video (YouTube link, optional)<input name="tutorVideoUrl" value="<%= proof.tutorVideoUrl %>" placeholder="https://www.youtube.com/watch?v=…"></label>
        <button class="btn">Save tutor profile</button>
      </form>
    </div>

    <div class="card" id="cohort">
      <h2>Next bootcamp cohort</h2>
      <p class="small muted">Drives the start date, the seats-left bar and the countdown bar on the home page and score plans. Hidden automatically once the date passes, or if left empty.</p>
      <form method="post" action="/admin/cohort" class="form proof-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row2">
          <label>Start date<input type="date" name="cohortStart" value="<%= proof.cohortStart %>"></label>
          <label>Schedule<input name="cohortSchedule" maxlength="120" value="<%= proof.cohortSchedule %>" placeholder="e.g. Tue &amp; Thu, 8–9:30 pm ET"></label>
        </div>
        <div class="row2">
          <label>Total seats<input type="number" min="0" name="cohortSeats" value="<%= proof.cohortSeats %>" placeholder="e.g. 10"></label>
          <label>Seats taken<input type="number" min="0" name="cohortTaken" value="<%= proof.cohortTaken %>" placeholder="e.g. 4"></label>
        </div>
        <button class="btn">Save cohort</button>
      </form>
    </div>

    <div class="card" id="proof">
      <h2>Social proof on the home page</h2>
      <p class="small muted">The "Real students. Real results." section, the rating badge and the counters appear on the home page only after you fill them in. Use real, verifiable information only, and only quote students who gave you permission. Fake reviews or made-up results are illegal under FTC rules.</p>
      <form method="post" action="/admin/proof" class="form proof-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row3">
          <label>Average rating (0–5)<input name="rating" value="<%= proof.rating %>" placeholder="e.g. 4.9"></label>
          <label>Number of ratings<input name="ratingCount" value="<%= proof.ratingCount %>" placeholder="e.g. 37"></label>
          <label>Students coached<input name="statStudents" value="<%= proof.statStudents %>" placeholder="e.g. 120+"></label>
        </div>
        <div class="row3">
          <label>Years teaching<input name="statYears" value="<%= proof.statYears %>" placeholder="e.g. 10"></label>
          <label>Results number<input name="statGain" value="<%= proof.statGain %>" placeholder="e.g. +8"></label>
          <label>Results label<input name="statGainLabel" value="<%= proof.statGainLabel %>" placeholder="e.g. average Quant score gain"></label>
        </div>
        <div class="row2">
          <label>Student video (YouTube link)<input name="videoUrl" value="<%= proof.videoUrl %>" placeholder="https://www.youtube.com/watch?v=…"></label>
          <label>Video caption<input name="videoTitle" value="<%= proof.videoTitle %>" placeholder="How Sara raised her Quant score from 74 to 83"></label>
        </div>
        <label>Schools your students were admitted to (one per line)<textarea name="schools" rows="3" placeholder="Wharton&#10;INSEAD"><%= proof.schools %></textarea></label>
        <button class="btn">Save</button>
      </form>

      <h3 style="margin-top:22px">Testimonials (<%= proof.testimonials.length %>)</h3>
      <% proof.testimonials.forEach(t => { %>
      <div class="admin-row" style="grid-template-columns:1fr auto">
        <div class="who"><strong><%= t.name %></strong><% if (t.before && t.after) { %> · <%= t.before %> → <%= t.after %><% } %><br><span class="small muted">“<%= t.quote.slice(0, 140) %><%= t.quote.length > 140 ? '…' : '' %>”</span></div>
        <form method="post" action="/admin/testimonial/<%= t.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost">Remove</button></form>
      </div>
      <% }) %>
      <form method="post" action="/admin/testimonial" class="form proof-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row3">
          <label>Student name<input name="name" maxlength="80" placeholder="Sara K." required></label>
          <label>Score before (optional)<input name="before" maxlength="12" placeholder="Q74"></label>
          <label>Score after (optional)<input name="after" maxlength="12" placeholder="Q83"></label>
        </div>
        <div class="row2">
          <label>Detail (optional)<input name="detail" maxlength="120" placeholder="Admitted to INSEAD, 2026"></label>
          <label>Photo link (optional, https)<input name="photo" type="url" placeholder="https://…/sara.jpg"></label>
        </div>
        <label>Quote<textarea name="quote" rows="3" maxlength="600" required></textarea></label>
        <label class="consent"><input type="checkbox" name="confirmed" value="yes" required> This is a real student who gave me permission to publish their words, name and photo.</label>
        <button class="btn">Add testimonial</button>
      </form>
    </div>

    <div class="card" id="tests">
      <h2>Practice test results</h2>
      <% if (!testAttempts.length) { %><p class="muted">None yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <tr><th>Date</th><th>Student</th><th>Score</th><th>Estimate</th><th>Time</th><th>Weakest topic</th></tr>
        <% testAttempts.forEach(t => { const st = students.find(s => s.id === t.userId); const w = t.byCategory.slice().sort((x, y) => x.correct / x.total - y.correct / y.total)[0]; %>
        <tr>
          <td><%= fmt(t.completedAt) %></td>
          <td><%= st ? st.name + ' · ' + st.email : '(tutor)' %></td>
          <td><a href="/practice-test/<%= t.id %>/results"><%= t.correct %>/<%= t.total %></a></td>
          <td><%= t.estimate.low %>–<%= t.estimate.high %></td>
          <td><%= Math.floor(t.seconds / 60) %>m</td>
          <td><%= w.category %> (<%= w.correct %>/<%= w.total %>)</td>
        </tr>
        <% }) %>
      </table></div>
      <% } %>
    </div>

    <div class="card" id="quiz">
      <h2>Quant score check results</h2>
      <p class="small muted">Emails appear only when the visitor ticked the consent box. Follow up with an invite to the free session.</p>
      <% if (!quizAttempts.length) { %><p class="muted">None yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <tr><th>Date</th><th>Name</th><th>Email / account</th><th>Score</th><th>Estimate</th><th>Time</th><th>Missed topics</th></tr>
        <% quizAttempts.forEach(q => { const acct = q.userId && students.concat([]).find(s => s.id === q.userId); %>
        <tr>
          <td><%= fmt(q.createdAt) %></td>
          <td><%= q.name || (acct ? acct.name : '') %></td>
          <td><%= q.email || (acct ? acct.email + ' (student)' : 'anonymous') %></td>
          <td><a href="/quiz/result/<%= q.id %>"><%= q.correct %>/<%= q.total %></a></td>
          <td><%= q.band.low %>–<%= q.band.high %></td>
          <td><%= q.seconds ? Math.floor(q.seconds/60) + 'm' : '—' %></td>
          <td style="white-space:normal;min-width:260px"><%= q.missedTopics.join(', ') %></td>
        </tr>
        <% }) %>
      </table></div>
      <% } %>
    </div>

    <div class="card">
      <h2>Students</h2>
      <div class="table-wrap"><table>
        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Test date</th><th>Target</th><th>Came from</th><th>Joined</th></tr>
        <% students.forEach(s => { %><tr><td><%= s.name %></td><td><%= s.email %></td><td><%= s.phone %></td><td><%= s.testDate %></td><td><%= s.targetScore %></td><td><%= s.source || '—' %></td><td><%= fmt(s.createdAt) %></td></tr><% }) %>
      </table></div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
